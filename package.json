{
  "name": "@aurokin/agent-policy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./policy.md": "./policy.md"
  },
  "files": [
    "dist",
    "policy.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "format": "prettier --write \"{src,test,scripts}/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.ts\" \"*.{json,md}\"",
    "render": "node --experimental-strip-types scripts/render.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "prepare": "pnpm build"
  },
  "packageManager": "pnpm@11.17.0",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
